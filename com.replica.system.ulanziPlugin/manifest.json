{
  "Version": "1.0.0",
  "Author": "Replica",
  "Name": "System",
  "Description": "Keys showing CPU usage, NVIDIA GPU usage and temperature, RAM usage, and disk space used.",
  "Icon": "assets/icons/icon.svg",
  "Category": "System",
  "CategoryIcon": "assets/icons/icon.svg",
  "CodePath": "plugin/app.js",
  "Type": "JavaScript",
  "PrivateAPI": true,
  "SupportedInMultiActions": false,
  "UUID": "com.replica.ulanzideck.system",
  "Actions": [
    {
      "Name": "CPU",
      "Icon": "assets/icons/cpu.svg",
      "state": 0,
      "States": [
        {
          "Name": "normal",
          "Image": "assets/icons/cpu.svg"
        }
      ],
      "Tooltip": "CPU usage.",
      "UUID": "com.replica.ulanzideck.system.cpu",
      "SupportedInMultiActions": false
    },
    {
      "Name": "GPU",
      "Icon": "assets/icons/gpu.svg",
      "state": 0,
      "States": [
        {
          "Name": "normal",
          "Image": "assets/icons/gpu.svg"
        }
      ],
      "Tooltip": "NVIDIA GPU usage and temperature.",
      "UUID": "com.replica.ulanzideck.system.gpu",
      "SupportedInMultiActions": false
    },
    {
      "Name": "RAM",
      "Icon": "assets/icons/ram.svg",
      "state": 0,
      "States": [
        {
          "Name": "normal",
          "Image": "assets/icons/ram.svg"
        }
      ],
      "Tooltip": "Memory in use.",
      "UUID": "com.replica.ulanzideck.system.ram",
      "SupportedInMultiActions": false
    },
    {
      "Name": "Disk",
      "Icon": "assets/icons/disk.svg",
      "state": 0,
      "States": [
        {
          "Name": "normal",
          "Image": "assets/icons/disk.svg"
        }
      ],
      "Tooltip": "Space used on a drive. Pick the drive in the key's settings.",
      "UUID": "com.replica.ulanzideck.system.disk",
      "PropertyInspectorPath": "property-inspector/disk.html",
      "SupportedInMultiActions": false
    }
  ],
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "6.1"
  }
}
